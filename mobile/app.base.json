{
  "expo": {
    "name": "Reborn Wave Group",
    "slug": "reborn-wave-group",
    "owner": "zensee",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "rebornwave",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#07101f"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#f0d787",
          "defaultChannel": "bridgex"
        }
      ]
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.zensee.rebornwavegroup",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Reborn Wave Group uses the camera to scan QR codes and upload account or payment images.",
        "NSPhotoLibraryUsageDescription": "Reborn Wave Group uses your photo library when you choose an account or payment image.",
        "NSMicrophoneUsageDescription": "Reborn Wave Group uses the microphone for karaoke and media features you start."
      },
      "associatedDomains": [
        "applinks:rebornwave.group",
        "applinks:www.rebornwave.group"
      ]
    },
    "android": {
      "package": "com.zensee.rebornwavegroup",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#07101f",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "rebornwave.group",
              "pathPrefix": "/kos"
            },
            {
              "scheme": "https",
              "host": "www.rebornwave.group",
              "pathPrefix": "/kos"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "e1d4fa37-5438-4cee-8f00-0b9796bc0f1d"
      }
    }
  }
}
